# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

# Color Palette
# Red    = #e06c75
# Green  = #98c379
# Blue   = #61afef
# Yellow = #e5c07b
# Magenta = #c678dd
# Cyan = #56b6c2

general {
	colors = true
	interval = 5
}
order += "cpu_usage"
order += "load"
order += "memory"
# order += "ipv6"
order += "wireless _first_"
order += "ethernet _first_"
order += "volume master"
order += "battery all"
order += "tztime time"

cpu_usage {
  format = " %usage"

  color_good = "#98c379"
  color_degraded = "#e5c07b"
  color_bad = "#e06c75"
}

load {
	format = " %1min"

  color_good = "#98c379"
  color_degraded = "#e5c07b"
  color_bad = "#e06c75"
}

memory {
	format = "󰘚 %used"
	threshold_degraded = "1G"

  color_good = "#98c379"
  color_degraded = "#e5c07b"
  color_bad = "#e06c75"
}

wireless _first_ {
	format_up = " %essid%quality"
	format_down = " down"

  color_good = "#98c379"
  color_degraded = "#e5c07b"
  color_bad = "#e06c75"
}

ethernet _first_ {
	format_up = " %speed"
	format_down = " down"

  color_good = "#98c379"
  color_degraded = "#e5c07b"
  color_bad = "#e06c75"
}

volume master {
	format = " %volume"
	format_muted = " %volume"
	device = "default"
	mixer = "Master"
	mixer_idx = 0

  color_good = "#98c379"
  color_degraded = "#e5c07b"
  color_bad = "#e06c75"
}

battery all {
	format = " %percentage"
  low_threshold = 20

  color_good = "#98c379"
  color_degraded = "#e5c07b"
  color_bad = "#e06c75"
}

tztime time {
	format = " %e %b %H:%M "
}

