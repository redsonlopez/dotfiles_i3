# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
	colors = true
	interval = 5

  color_good = "#98c379"      # Green
  color_degraded = "#e5c07b"  # Yellow
  color_bad = "#e06c75"       # Red
}

order += "cpu_usage"
order += "load"
order += "memory"
# order += "ipv6"
order += "wireless _first_"
order += "ethernet _first_"
order += "volume master"
order += "battery all"
order += "tztime time"

cpu_usage {
  format = " %usage"
}

load {
	format = " %1min"
  max_threshold = "5"
}

memory {
	format = "󰘚 %used"
	threshold_degraded = "1G"
  threshold_critical = "500M"
}

wireless _first_ {
	format_up = " %essid%quality"
	format_down = " down"
}

ethernet _first_ {
	format_up = " %speed"
	format_down = " down"
}

volume master {
	format = " %volume"
	format_muted = " %volume"
	device = "pulse"
}

battery all {
	format = " %percentage"
  low_threshold = 20
  threshold_type = "percentage"
}

tztime time {
	format = " %e %b %H:%M "
}

